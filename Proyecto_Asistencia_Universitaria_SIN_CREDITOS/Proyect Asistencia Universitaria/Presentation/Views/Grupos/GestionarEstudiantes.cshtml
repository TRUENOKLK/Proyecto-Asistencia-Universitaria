@using Aplication.DTos
@{
    var grupo = (GrupoDto)ViewBag.Grupo;
    var inscritos = (IEnumerable<EstudianteEnGrupoDto>)ViewBag.Inscritos;
    var disponibles = (IEnumerable<EstudianteEnGrupoDto>)ViewBag.Disponibles;
    ViewData["Title"] = "Inscribir Estudiantes";
}

<div class="container py-4 uni-animate-in">
    <div class="text-center mb-5">
        <h1 class="bto-heading">Inscripción de Estudiantes<span class="text-accent">.</span></h1>
        <p class="fs-5 text-muted">
            Grupo <strong>@grupo.NombreGrupo</strong> — @grupo.NombreAsignatura
            (<span class="badge rounded-pill uni-badge-primary">@grupo.NombrePeriodo</span>)
            &middot; Docente: @grupo.Docente
        </p>
        <a asp-action="ListarGrupos" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Volver a Grupos
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
      
        <div class="col-lg-6">
            <h5 class="fw-semibold mb-3"><i class="bi bi-people-fill me-2"></i>Inscritos (@inscritos.Count())</h5>
            <div class="table-custom">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Carnet</th>
                            <th>Estudiante</th>
                            <th>Carrera</th>
                            <th class="text-center">Quitar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (inscritos.Any())
                        {
                            foreach (var e in inscritos)
                            {
                                <tr>
                                    <td>@e.Carnet</td>
                                    <td class="fw-semibold">@e.Nombres @e.Apellidos</td>
                                    <td>@e.NombreCarrera</td>
                                    <td class="text-center">
                                        <form asp-action="DesinscribirEstudiante" method="post"
                                              onsubmit="return confirm('¿Retirar a @e.Nombres @e.Apellidos de este grupo?');">
                                            <input type="hidden" name="idGrupo" value="@grupo.IdGrupo" />
                                            <input type="hidden" name="idEstudiante" value="@e.IdEstudiante" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Quitar del grupo">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Todavía no hay estudiantes inscritos en este grupo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <div class="col-lg-6">
            <h5 class="fw-semibold mb-3"><i class="bi bi-person-plus-fill me-2"></i>Disponibles para inscribir (@disponibles.Count())</h5>
            <div class="table-custom">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Carnet</th>
                            <th>Estudiante</th>
                            <th>Carrera</th>
                            <th class="text-center">Agregar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (disponibles.Any())
                        {
                            foreach (var e in disponibles)
                            {
                                <tr>
                                    <td>@e.Carnet</td>
                                    <td class="fw-semibold">@e.Nombres @e.Apellidos</td>
                                    <td>@e.NombreCarrera</td>
                                    <td class="text-center">
                                        <form asp-action="InscribirEstudiante" method="post">
                                            <input type="hidden" name="idGrupo" value="@grupo.IdGrupo" />
                                            <input type="hidden" name="idEstudiante" value="@e.IdEstudiante" />
                                            <button type="submit" class="btn btn-sm btn-bto-primary rounded-pill px-3" title="Inscribir en el grupo">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No hay estudiantes activos disponibles para inscribir.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

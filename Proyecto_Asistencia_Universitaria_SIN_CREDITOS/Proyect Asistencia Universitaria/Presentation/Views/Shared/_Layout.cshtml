@{
    // Resalta el enlace del menú que corresponde al controlador actual.
    string NavActivo(params string[] controladores)
    {
        var actual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        return controladores.Any(c => string.Equals(c, actual, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asistencia UNI</title>

    <!-- Fuentes e iconos -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-custom mb-5">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i>Asistencia UNI
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link @NavActivo("Estudiantes")" asp-area="" asp-controller="Estudiantes" asp-action="ListarEstudiantes"><i class="bi bi-people me-1"></i>Estudiantes</a></li>
                                <li class="nav-item"><a class="nav-link @NavActivo("Profesores")" asp-area="" asp-controller="Profesores" asp-action="ListarProfesores"><i class="bi bi-person-video3 me-1"></i>Profesores</a></li>
                                <li class="nav-item"><a class="nav-link @NavActivo("Auditoria")" asp-area="" asp-controller="Auditoria" asp-action="Index"><i class="bi bi-shield-check me-1"></i>Auditoría</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @NavActivo("Facultades", "Carreras", "Asignaturas", "Periodos")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-journal-bookmark me-1"></i>Académico
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Facultades" asp-action="ListarFacultades"><i class="bi bi-building me-2"></i>Facultades</a></li>
                                        <li><a class="dropdown-item" asp-controller="Carreras" asp-action="ListarCarreras"><i class="bi bi-mortarboard me-2"></i>Carreras</a></li>
                                        <li><a class="dropdown-item" asp-controller="Asignaturas" asp-action="ListarAsignaturas"><i class="bi bi-journal-text me-2"></i>Asignaturas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Periodos" asp-action="ListarPeriodos"><i class="bi bi-calendar3 me-2"></i>Periodos</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Administrador") || User.IsInRole("Profesor"))
                            {
                                <li class="nav-item"><a class="nav-link @NavActivo("Grupos", "Operaciones")" asp-area="" asp-controller="Grupos" asp-action="ListarGrupos"><i class="bi bi-clipboard2-check me-1"></i>Asistencia</a></li>
                            }

                            @if (User.IsInRole("Estudiante"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="MisAsistencias"><i class="bi bi-clipboard2-data me-1"></i>Mi Asistencia</a></li>
                            }

                            <li class="nav-item ms-2 d-flex align-items-center">
                                <span class="nav-link mb-0 pe-2" style="font-size:0.85rem;">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                                    <span class="badge rounded-pill ms-1" style="background-color: var(--uni-primary);">@(User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Profesor") ? "Profesor" : "Estudiante")</span>
                                </span>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-5">
            @if (TempData["MensajeExito"] != null)
            {
                <div class="container mb-4" style="max-width: 900px;">
                    <div class="uni-alert-success d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <span>@TempData["MensajeExito"]</span>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="container mb-4" style="max-width: 900px;">
                    <div class="alert alert-danger d-flex align-items-center rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

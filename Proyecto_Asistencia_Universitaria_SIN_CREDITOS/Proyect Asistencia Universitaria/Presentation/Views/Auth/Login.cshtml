@model Aplication.DTos.LoginDto
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Asistencia Universitaria</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body.login-body {
            min-height: 100vh;
            display: flex;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #eef2ff 0%, #f4f6fb 45%, #e9fbf6 100%);
        }

        .login-shell {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        .login-visual {
            flex: 1;
            display: none;
            flex-direction: column;
            justify-content: center;
            padding: 4rem;
            background: linear-gradient(160deg, var(--uni-primary) 0%, #2743a8 100%);
            color: #fff;
            position: relative;
            overflow: hidden;
        }

        .login-visual::after {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -120px;
            right: -120px;
        }

        .login-visual h2 {
            font-weight: 800;
            font-size: 2.4rem;
            letter-spacing: -1px;
            margin-bottom: 1rem;
            animation: uniFadeInUp 0.6s ease both;
        }

        .login-visual p {
            font-size: 1.05rem;
            opacity: 0.9;
            max-width: 420px;
            animation: uniFadeInUp 0.6s ease 0.1s both;
        }

        .login-visual .bi {
            font-size: 3.2rem;
            margin-bottom: 1.5rem;
            animation: uniFadeInUp 0.6s ease both;
        }

        @@media (min-width: 992px) {
            .login-visual { display: flex; }
        }

        .login-form-side {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: var(--uni-surface);
            border-radius: 22px;
            padding: 2.75rem;
            box-shadow: var(--uni-shadow-hover);
            animation: uniFadeInUp 0.5s ease both;
        }

        .login-logo {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--uni-primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 8px 20px rgba(52, 87, 213, 0.3);
        }

        .login-card h1 {
            font-weight: 800;
            font-size: 1.9rem;
            letter-spacing: -0.5px;
            color: var(--uni-text);
            margin-bottom: 0.25rem;
        }

        .login-card p.subtitle { color: var(--uni-text-muted); margin-bottom: 1.75rem; }

        .password-field { position: relative; }
        .password-toggle {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--uni-text-muted);
            cursor: pointer;
        }
        .password-toggle:hover { color: var(--uni-primary); }
    </style>
</head>
<body class="login-body">
    <div class="login-shell">
        <div class="login-visual">
            <i class="bi bi-mortarboard-fill"></i>
            <h2>Asistencia Universitaria</h2>
            <p>Gestiona sesiones, controla la asistencia y consulta tus reportes desde un solo lugar, diseñado para administradores, profesores y estudiantes.</p>
        </div>

        <div class="login-form-side">
            <div class="login-card">
                <div class="login-logo"><i class="bi bi-shield-lock-fill"></i></div>
                <h1>Bienvenido de vuelta</h1>
                <p class="subtitle">Ingresa con tu correo institucional para continuar.</p>

                <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm" novalidate>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 py-2 mb-3" style="font-size: 0.9rem;">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="usuario@uni.edu.ni" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="password-field">
                            <input asp-for="Password" id="passwordInput" class="form-control form-control-lg" type="password" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="password-toggle" id="togglePassword" aria-label="Mostrar contraseña">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" id="loginSubmit" class="btn btn-bto-primary btn-lg fw-bold">
                            <span id="loginSubmitText">Ingresar al sistema</span>
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted" style="font-size: 0.82rem;">&copy; 2026 Universidad &middot; Sistema de Asistencia</p>
                    <p class="text-muted" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle me-1"></i>
                        Solo el administrador puede crear cuentas nuevas. Tu correo institucional se genera automáticamente al registrarte.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('passwordInput');
            var icon = document.getElementById('toggleIcon');
            var showing = input.type === 'text';
            input.type = showing ? 'password' : 'text';
            icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
        });

        
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            if (!$(this).valid()) return;
            var btn = document.getElementById('loginSubmit');
            document.getElementById('loginSubmitText').innerHTML = '<span class="uni-spinner me-2"></span>Verificando...';
            btn.disabled = true;
        });
    </script>
</body>
</html>

@model Aplication.DTos.EstudianteDto
@{
    ViewData["Title"] = "Nuevo Estudiante";
}

<div class="container uni-animate-in" style="max-width: 650px; margin-bottom: 4rem;">
    <div class="text-center mb-5">
        <h1 class="bto-heading" style="font-size: 2.3rem;">Nuevo Estudiante<span class="text-accent">.</span></h1>
        <p class="text-muted">El correo institucional se genera automáticamente al guardar.</p>
    </div>

    <div class="bto-form-card">
        <form asp-action="NuevoEstudiante" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Carnet" class="form-label">Carnet Universitario</label>
                <input asp-for="Carnet" class="form-control" placeholder="Ej: 2026-0001U" />
                <span asp-validation-for="Carnet" class="text-danger"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label asp-for="Nombres" class="form-label"></label>
                    <input asp-for="Nombres" class="form-control" />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellidos" class="form-label"></label>
                    <input asp-for="Apellidos" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="IdCarrera" class="form-label">Carrera</label>
                <select asp-for="IdCarrera" asp-items="ViewBag.ListaCarreras" class="form-select">
                    <option value="">-- Selecciona una carrera --</option>
                </select>
                <span asp-validation-for="IdCarrera" class="text-danger"></span>
            </div>

            <h5 class="text-accent fw-bold mt-5 mb-3 border-bottom pb-2">Datos de acceso</h5>
            <div class="alert alert-light border d-flex align-items-start" style="font-size: 0.85rem; background-color: #f8f9fd;">
                <i class="bi bi-envelope-check me-2 mt-1"></i>
                <span>El correo institucional (nombre.apellido@est.uni.edu.ni) se creará automáticamente. Solo define una contraseña temporal.</span>
            </div>

            <div class="mb-4">
                <label asp-for="PasswordHash" class="form-label"></label>
                <input asp-for="PasswordHash" class="form-control" type="password" placeholder="Mínimo 8 caracteres, mayúscula, número y símbolo" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="mb-5">
                <label asp-for="ConfirmarPassword" class="form-label"></label>
                <input asp-for="ConfirmarPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
            </div>

            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-bto-primary btn-lg">Guardar Estudiante</button>
                <a asp-action="ListarEstudiantes" class="btn btn-link text-muted text-decoration-none fw-bold text-center">Cancelar y volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
